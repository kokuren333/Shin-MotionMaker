{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "smm.check/1",
  "type": "object",
  "properties": {
    "verdict": {
      "enum": [
        "pass",
        "fail",
        "not_applicable"
      ]
    },
    "report": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "report",
    "artifacts"
  ],
  "additionalProperties": false
}
