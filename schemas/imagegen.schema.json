{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "smm.imagegen/1",
  "type": "object",
  "properties": {
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "skipped"
            ]
          },
          "path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          }
        },
        "required": [
          "status"
        ]
      }
    }
  },
  "required": [
    "assets"
  ],
  "additionalProperties": false
}
