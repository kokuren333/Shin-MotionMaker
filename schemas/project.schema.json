{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "smm.project/1",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "0.4",
        "0.5"
      ]
    },
    "title": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "mv",
        "explanation"
      ]
    },
    "generator": {
      "type": "object",
      "properties": {
        "name": {
          "const": "shin-motionmaker"
        },
        "version": {
          "type": "string"
        },
        "template_version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "template_version"
      ],
      "additionalProperties": false
    },
    "scenes": {
      "type": "array",
      "items": {}
    }
  },
  "required": [
    "schema_version",
    "title",
    "mode",
    "scenes"
  ],
  "additionalProperties": true,
  "oneOf": [
    {
      "properties": {
        "schema_version": {
          "const": "0.4"
        }
      }
    },
    {
      "properties": {
        "schema_version": {
          "const": "0.5"
        }
      },
      "required": [
        "generator"
      ]
    }
  ]
}
