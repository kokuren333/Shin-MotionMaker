{
  "format": "shin-motionmaker-icons",
  "version": 1,
  "palette": "assets/ui/icons/ui-icons.gpl",
  "size_policy": {
    "rule": "gui/public/icons/ 直下の PNG はすべて 16x16（scale 1）。16x16 以外の PNG は icons/ の外にだけ置き、files[].scale で倍率を明記する（寸法は 16 x scale の整数倍）。",
    "exceptions": [
      {
        "path": "gui/public/favicon.png",
        "icon": "app",
        "scale": 2,
        "reason": "favicon の大きい版（整数倍の書き出し）"
      }
    ]
  },
  "export": {
    "command": "cybersprite -p <source> export image --out <png> --scale <n> --compression stored",
    "note": "stored は決定論の PNG。同じ原本と同じ CyberSprite から同じバイトになる。"
  },
