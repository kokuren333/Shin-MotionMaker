{
  "name": "shin-motionmaker",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "shin-motionmaker": "dist/cli/main.js",
    "smm": "dist/cli/main.js"
  },
  "workspaces": [
    "gui"
  ],
  "files": ["dist", "job-template", "job-assets/fonts", "schemas", "LICENSE", "NOTICE"],
  "scripts": {
    "test": "node --experimental-strip-types --test \"tests/**/*.test.ts\"",
    "pretest": "npm run build",
    "test:tier-b": "npm run build && node tools/tier-b.mjs",
    "test:runtime": "npm run build && node tools/runtime-smoke.mjs",
    "verify:pages:local": "node tools/verify-pages-local.mjs",
    "build": "tsc --noEmit && tsc -p tsconfig.build.json",
    "ci:local": "node tools/ci-local.mjs"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "jszip": "3.10.1"
  }
}
