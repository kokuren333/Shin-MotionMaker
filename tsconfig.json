{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "dist", "tests/fixtures",
    "tests/job.test.ts", "tests/ghost.test.ts", "tests/imagegen.test.ts", "tests/voice.test.ts",
    "tests/qc.test.ts", "tests/harness-docs.test.ts", "tests/explainer.test.ts"]
}
